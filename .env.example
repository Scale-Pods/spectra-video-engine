# Google Cloud configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VEO_MODEL_ID=veo-3.1-generate-001
VEO_OUTPUT_BUCKET=your-gcs-bucket-name

# GCP Service Account JSON (REQUIRED on Railway for cloud authentication)
# Paste the entire contents of your service-account-key.json as a single line string,
# or base64 encode it.
GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_VIDEO_BUCKET=generated-videos
SUPABASE_BUCKET_PRIVATE=false

# Authentication token for endpoints in this service
RENDER_API_TOKEN=your-random-secret-token
